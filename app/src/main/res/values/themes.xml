<resources>
    <!--
        windowBackground/statusBarColor/navigationBarColor only matter for the brief frame
        before enableEdgeToEdge() and Compose take over in onCreate; without them the platform
        default (a plain white background from the Material.Light parent) flashes at cold start.
        Kept dark unconditionally, regardless of the device's eventual light/dark theme, since a
        dark flash reads as a neutral loading state either way and never looks as jarring as a
        white one.
    -->
    <style name="Theme.NewBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
    </style>

    <!--
        The activity's actual theme at launch; installSplashScreen() in MainActivity swaps it
        for Theme.NewBrowser once the first frame is ready. windowSplashScreenAnimatedIcon is
        the CYN wordmark tinted magenta (the source PNG is a dark, near-invisible grey that
        would disappear against this near-black background otherwise).
    -->
    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NewBrowser</item>
    </style>
</resources>
