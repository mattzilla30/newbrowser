<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed by DownloadManager to write to the public Downloads directory on API < 29. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Requested at runtime before posting a Web Head notification/bubble (API 33+ only;
         posting notifications was ungated before that). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        These four are only requested at runtime, with an explicit allow/deny prompt, when a
        web page asks for camera, microphone, or location access (WebView's onPermissionRequest
        / onGeolocationPermissionsShowPrompt). Declaring them here is required for that runtime
        request to work at all; it does not grant anything by itself.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Declaring the CAMERA permission alone can make some stores assume the hardware is
         required; these mark it optional so the app still installs on devices without one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.NewBrowser"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Splash"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:allowEmbedded="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Without this, the app can only ever be opened from its own launcher icon: it
                can't be offered when a link is tapped elsewhere, and Android won't list it as
                an option under Settings > Apps > Default apps > Browser app. autoVerify is left
                off since that requires hosting a Digital Asset Links file, which this app has
                nowhere to serve from; the user still gets the disambiguation/"always" prompt.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Lets other apps open a saved-page file this app owns without exposing a raw
             file:// path, which Android blocks in shared intents on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
